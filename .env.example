# Copy to .env and fill in. Never commit .env.

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# 1. Create a free project at https://console.neon.tech
# 2. Dashboard → Connection details → copy connection strings
#
# DATABASE_URL  = pooled connection (for the Next.js app / Netlify)
# DIRECT_URL    = direct connection (for prisma db push / migrate / seed)
#
# Example (replace user, password, endpoint, db name).
# Use sslmode=verify-full (not require) to avoid node-pg deprecation warnings.
# DATABASE_URL="postgresql://neondb_owner:xxxx@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
# DIRECT_URL="postgresql://neondb_owner:xxxx@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=verify-full"

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"

# ─── Auth ───────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Signs iron-session cookies AND CSRF JWTs.
SESSION_SECRET=change-me

# mock | paystack (see docs/05-payment-flow.md)
PAYMENT_GATEWAY=mock

# Optional second factor for /admin/* (HTTP Basic). Leave both unset in
# local/e2e so session login alone is enough. Set both in production.
# ADMIN_BASIC_USER=admin
# ADMIN_BASIC_PASSWORD=replace-me

# Public site URL (canonical / OG / sitemap) once deployed.
# Used in notification email links (My Bookings, admin panels).
# NEXT_PUBLIC_SITE_URL=https://atu-hostel-system.netlify.app

# ─── Email notifications ────────────────────────────────────────────────────
# Default: console transport (logs to server stdout - fine for local/e2e).
# Set SMTP_HOST to deliver real mail (Mailtrap, Gmail app password, SendGrid…).
#
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password
# SMTP_FROM="ATU Hostel Booking <noreply@atu.edu.gh>"
#
# Without SMTP_*, password reset + booking/payment emails are printed as:
#   [mailer] to=… subject="…"
#
# Status, a connection probe, and a test-send live at /admin/notifications.
# Pause outbound mail without unsetting SMTP (in-app inbox still writes):
# EMAIL_NOTIFICATIONS=off
#
# Mailtrap Email Templates (optional). Design in Mailtrap, send via API.
# Token: Mailtrap -> API Tokens. Inbox ID: the number in the sandbox URL.
# MAILTRAP_API_TOKEN=
# MAILTRAP_INBOX_ID=
# MAILTRAP_TEMPLATE_TEST=
# MAILTRAP_TEMPLATE_BOOKING_RECEIVED=
# MAILTRAP_TEMPLATE_BOOKING_CREATED_STAFF=
# MAILTRAP_TEMPLATE_BOOKING_APPROVED=
# MAILTRAP_TEMPLATE_BOOKING_REJECTED=
# MAILTRAP_TEMPLATE_PAYMENT_SUBMITTED=
# MAILTRAP_TEMPLATE_PAYMENT_VERIFIED=
# MAILTRAP_TEMPLATE_PASSWORD_RESET=

# E2E (Playwright) - optional separate Neon branch URL; defaults to DATABASE_URL
# E2E_DATABASE_URL="postgresql://..."
